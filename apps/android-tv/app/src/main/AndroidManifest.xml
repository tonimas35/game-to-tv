<?xml version="1.0" encoding="utf-8"?>
<!--
  «Juegos del Salón» for Android TV, Google TV and Fire TV.
  MainActivity (main process): fullscreen WebView with the TV page.
  NodeService (process :node): foreground service that runs the game server
  on nodejs-mobile. Node can only start once per process, so the process ends
  with the server (idle shutdown) and a new one is started on the next launch.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Android 14+: every foreground service declares a type -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- TV first, but nothing is strictly required (Fire TV, phones for testing) -->
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.wifi" android:required="false" />
    <uses-feature android:name="android.hardware.ethernet" android:required="false" />

    <application
        android:allowBackup="false"
        android:banner="@drawable/banner"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="false"
        android:theme="@style/Theme.Juegos"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:configChanges="density|fontScale|keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="stateAlwaysHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <!-- Android TV / Google TV home screen -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
                <!-- Fire TV (and phones) -->
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".NodeService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:process=":node">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Servidor de juegos local (HTTP + WebSocket en el puerto 8090) para los móviles de la red de casa mientras la app está abierta" />
        </service>
    </application>
</manifest>
